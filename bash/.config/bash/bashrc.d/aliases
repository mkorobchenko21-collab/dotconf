#!/bin/bash

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

alias l='ls -la'
alias cp='cp -i'
alias mv='mv -i'
alias ..='cd ..'
alias ...='cd ../..'
alias back='cd $OLDPWD'

alias v='vim'
alias nv='nvim'
alias nvf='find ~/ | fzf -m --preview="batcat --color=always {}" --bind "enter:become(nvim {+})"'
alias nvcf='fzf -m --preview="batcat --color=always {}" --bind "enter:become(nvim {+})"'
alias nvfd='find ~/ -type d | fzf -m --preview="batcat --color=always {}" --bind "enter:become(nvim {+})"'
alias nvcfd='find . -type d | fzf -m --preview="batcat --color=always {}" --bind "enter:become(nvim {+})"'
alias se='sudoedit'

# git aliases
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gco='git checkout'
